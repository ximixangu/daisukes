# Dificultat (debug/status): mode del menu, fase i quants en surten ara (engine/progress/update_count)
execute if score #mode daisukes.config matches 1 run tellraw @a ["", {"text": "   Difficulty: ", "color": "gray"}, {"text": "milestones", "color": "white"}, {"text": " · phase ", "color": "gray"}, {"score": {"name": "#current_phase", "objective": "daisukes.engine"}, "color": "gold", "bold": true}, {"text": "/6 · ", "color": "gray"}, {"score": {"name": "#current_top", "objective": "daisukes.engine"}, "color": "gold", "bold": true}, {"text": "-", "color": "gold", "bold": true}, {"score": {"name": "#current_low", "objective": "daisukes.engine"}, "color": "gold", "bold": true}]
execute if score #mode daisukes.config matches 1 if score #current_phase daisukes.engine matches ..2 run tellraw @a ["", {"text": "   Blaze rod: ", "color": "gray"}, {"score": {"name": "#blaze_reached", "objective": "daisukes.engine"}, "color": "white"}, {"text": " · Piglin trade: ", "color": "gray"}, {"score": {"name": "#piglin_reached", "objective": "daisukes.engine"}, "color": "white"}, {"text": " (1 = done)", "color": "dark_gray"}]
execute if score #mode daisukes.config matches 2 run tellraw @a ["", {"text": "   Difficulty: ", "color": "gray"}, {"text": "over time", "color": "white"}, {"text": " · now ", "color": "gray"}, {"score": {"name": "#current_top", "objective": "daisukes.engine"}, "color": "gold", "bold": true}, {"text": " · one more every ", "color": "gray"}, {"score": {"name": "#every_seconds", "objective": "daisukes.config"}, "color": "white"}, {"text": " s", "color": "gray"}]
execute if score #mode daisukes.config matches 3 run tellraw @a ["", {"text": "   Difficulty: ", "color": "gray"}, {"text": "fixed", "color": "white"}, {"text": " · ", "color": "gray"}, {"score": {"name": "#current_top", "objective": "daisukes.engine"}, "color": "gold", "bold": true}]
