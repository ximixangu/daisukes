# Dificultat (debug/status): fase actual i el que la fara pujar (engine/progress/update_count)
scoreboard players operation #alt_min daisukes.math = #alternate_seconds daisukes.config
scoreboard players operation #alt_min daisukes.math /= #60 daisukes.math

# Minuts que falten per a la fase 4 (#late_seconds despres de la fase 3)
scoreboard players operation #late_min daisukes.math = #late_seconds daisukes.config
scoreboard players operation #late_min daisukes.math *= #20 daisukes.math
scoreboard players operation #late_min daisukes.math += #nether_goals_time daisukes.engine
scoreboard players operation #late_min daisukes.math -= #elapsed daisukes.engine
scoreboard players operation #late_min daisukes.math /= #20 daisukes.math
scoreboard players operation #late_min daisukes.math /= #60 daisukes.math

execute if score #current_phase daisukes.engine matches ..1 run tellraw @a ["", {"text": "   Difficulty: ", "color": "gray"}, {"score": {"name": "#start_count", "objective": "daisukes.config"}, "color": "gold", "bold": true}, {"text": " · ", "color": "gray"}, {"score": {"name": "#alternate_high", "objective": "daisukes.config"}, "color": "white"}, {"text": "-", "color": "white"}, {"score": {"name": "#alternate_low", "objective": "daisukes.config"}, "color": "white"}, {"text": " at minute ", "color": "gray"}, {"score": {"name": "#alt_min", "objective": "daisukes.math"}, "color": "white"}, {"text": " or in the Nether", "color": "gray"}]
execute if score #current_phase daisukes.engine matches 2 run tellraw @a ["", {"text": "   Difficulty: ", "color": "gray"}, {"score": {"name": "#alternate_high", "objective": "daisukes.config"}, "color": "gold", "bold": true}, {"text": "-", "color": "gold", "bold": true}, {"score": {"name": "#alternate_low", "objective": "daisukes.config"}, "color": "gold", "bold": true}, {"text": " · ", "color": "gray"}, {"score": {"name": "#nether_goals_count", "objective": "daisukes.config"}, "color": "white"}, {"text": " with a blaze rod and a bastion", "color": "gray"}]
execute if score #current_phase daisukes.engine matches ..2 run tellraw @a ["", {"text": "   Blaze rod: ", "color": "gray"}, {"score": {"name": "#blaze_reached", "objective": "daisukes.engine"}, "color": "white"}, {"text": " · Bastion: ", "color": "gray"}, {"score": {"name": "#bastion_reached", "objective": "daisukes.engine"}, "color": "white"}, {"text": " (1 = done)", "color": "dark_gray"}]
execute if score #current_phase daisukes.engine matches 3 run tellraw @a ["", {"text": "   Difficulty: ", "color": "gray"}, {"score": {"name": "#nether_goals_count", "objective": "daisukes.config"}, "color": "gold", "bold": true}, {"text": " · ", "color": "gray"}, {"score": {"name": "#late_high", "objective": "daisukes.config"}, "color": "white"}, {"text": "-", "color": "white"}, {"score": {"name": "#late_low", "objective": "daisukes.config"}, "color": "white"}, {"text": " in ", "color": "gray"}, {"score": {"name": "#late_min", "objective": "daisukes.math"}, "color": "white"}, {"text": " min, ", "color": "gray"}, {"score": {"name": "#stronghold_count", "objective": "daisukes.config"}, "color": "white"}, {"text": " in the stronghold", "color": "gray"}]
execute if score #current_phase daisukes.engine matches 4 run tellraw @a ["", {"text": "   Difficulty: ", "color": "gray"}, {"score": {"name": "#late_high", "objective": "daisukes.config"}, "color": "gold", "bold": true}, {"text": "-", "color": "gold", "bold": true}, {"score": {"name": "#late_low", "objective": "daisukes.config"}, "color": "gold", "bold": true}, {"text": " · ", "color": "gray"}, {"score": {"name": "#stronghold_count", "objective": "daisukes.config"}, "color": "white"}, {"text": " in the stronghold", "color": "gray"}]
execute if score #current_phase daisukes.engine matches 5 run tellraw @a ["", {"text": "   Difficulty: ", "color": "gray"}, {"score": {"name": "#stronghold_count", "objective": "daisukes.config"}, "color": "gold", "bold": true}, {"text": " · ", "color": "gray"}, {"score": {"name": "#end_count", "objective": "daisukes.config"}, "color": "white"}, {"text": " in the End", "color": "gray"}]
execute if score #current_phase daisukes.engine matches 6 run tellraw @a ["", {"text": "   Difficulty: ", "color": "gray"}, {"score": {"name": "#end_count", "objective": "daisukes.config"}, "color": "gold", "bold": true}, {"text": " (End)", "color": "gray"}]
