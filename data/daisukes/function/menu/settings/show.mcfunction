# Dialeg d'opcions: com en surten els modificadors i cada quant canvien, i si morir acaba el repte.
# Es munta cada cop perque cada opcio surti amb el valor desat (initial) i a dalt el resum (settings/summary).
# Save ho envia tot en un sol numero, una xifra per opcio (menu/settings/save):
#   /trigger daisukes.menu set 1<mode><start><every><max><change><endfast><death>
# Les opcions predefinides (11-14) es desen directament (menu/settings/preset)
function daisukes:settings/summary

data modify storage daisukes:menu dialog set value {type: "minecraft:multi_action", title: {text: "Settings", color: "red", bold: true}, body: [{type: "minecraft:plain_message", width: 300, contents: {text: "Now: ", color: "gray", extra: [{text: ""}]}}, {type: "minecraft:plain_message", width: 300, contents: {text: "", color: "gray", extra: [{text: "Difficulty", color: "white"}, {text: " is how many modifiers are active at once. "}, {text: "Daisuke's milestones", color: "white"}, {text: ": 1 → 2-1 after 40 min or in the Nether → 2 with a blaze rod and a piglin trade → 3-2 40 min later → 3 in the stronghold → 4 in the End. 2-1 means they alternate: 2, then 1, then 2... "}, {text: "Over time", color: "white"}, {text: ": one more every few minutes. "}, {text: "Fixed", color: "white"}, {text: ": never goes up.\n"}, {text: "More at the start adds the same to every step. If the challenge is running, changes apply from the next modifier change."}]}}], inputs: [{type: "minecraft:single_option", key: "mode", label: "Difficulty", width: 300, options: [{id: "1", display: "Daisuke's milestones"}, {id: "2", display: "Goes up over time"}, {id: "3", display: "Fixed"}]}, {type: "minecraft:single_option", key: "start", label: "Modifiers at the start", width: 300, options: [{id: "1"}, {id: "2"}, {id: "3"}, {id: "4"}, {id: "5"}]}, {type: "minecraft:single_option", key: "every", label: "Over time, one more every", width: 300, options: [{id: "1", display: "10 min"}, {id: "2", display: "15 min"}, {id: "3", display: "20 min"}, {id: "4", display: "30 min"}, {id: "5", display: "45 min"}, {id: "6", display: "1 hour"}]}, {type: "minecraft:single_option", key: "max", label: "Most at once", width: 300, options: [{id: "0", display: "No limit"}, {id: "2"}, {id: "3"}, {id: "4"}, {id: "5"}, {id: "6"}]}, {type: "minecraft:single_option", key: "change", label: "Modifiers change every", width: 300, options: [{id: "1", display: "30 s"}, {id: "2", display: "45 s"}, {id: "3", display: "1 min"}, {id: "4", display: "1 min 30 s"}, {id: "5", display: "2 min"}, {id: "6", display: "3 min"}, {id: "7", display: "4 min"}, {id: "8", display: "5 min"}]}, {type: "minecraft:boolean", key: "endfast", label: "They change twice as fast in the End", on_true: "1", on_false: "0"}, {type: "minecraft:boolean", key: "death", label: "A death ends the challenge", on_true: "1", on_false: "0"}], actions: [{label: {text: "✔ Save", color: "green"}, tooltip: "Save these settings", width: 148, action: {type: "minecraft:dynamic/run_command", template: "trigger daisukes.menu set 1$(mode)$(start)$(every)$(max)$(change)$(endfast)$(death)"}}, {label: "◀ Back", tooltip: "Back to the menu. Changes that weren't saved are lost.", width: 148, action: {type: "minecraft:run_command", command: "/trigger daisukes.menu set 1"}}, {label: "Default", tooltip: "Daisuke's original challenge: Daisuke's milestones, 1 at the start, no limit, they change every 2 min (1 min in the End) and a death ends it. It also enables every modifier again.", width: 148, action: {type: "minecraft:run_command", command: "/trigger daisukes.menu set 11"}}, {label: "Easy", tooltip: "Daisuke's milestones but at most 2 at once, they change every 3 min (1 min 30 s in the End) and deaths don't end the challenge", width: 148, action: {type: "minecraft:run_command", command: "/trigger daisukes.menu set 12"}}, {label: "Hard", tooltip: "Daisuke's milestones starting with 2 (2 → 3-2 → 3 → 4-3 → 4 → 5), they change every 1 min 30 s (45 s in the End) and a death ends it", width: 148, action: {type: "minecraft:run_command", command: "/trigger daisukes.menu set 13"}}, {label: "Chaos", tooltip: "3 at the start and one more every 15 min, up to 6 at once. They change every 30 s (15 s in the End) and a death ends it", width: 148, action: {type: "minecraft:run_command", command: "/trigger daisukes.menu set 14"}}], columns: 2, pause: false, after_action: "none"}

# Resum de la configuracio desada (a dalt)
data modify storage daisukes:menu dialog.body[0].contents.extra[0] set from storage daisukes:menu summary

# Avis de l'ultim canvi (Saved, opcions predefinides), a sobre de tot. Nomes surt un cop
execute if data storage daisukes:menu notice run data modify storage daisukes:menu dialog.body prepend value {type: "minecraft:plain_message", width: 300, contents: {text: ""}}
execute if data storage daisukes:menu notice run data modify storage daisukes:menu dialog.body[0].contents set from storage daisukes:menu notice
data remove storage daisukes:menu notice

# Cada opcio amb el valor desat
execute store result storage daisukes:menu args.mode int 1 run scoreboard players get #mode daisukes.config
execute store result storage daisukes:menu args.start int 1 run scoreboard players get #start_count daisukes.config
execute store result storage daisukes:menu args.every int 1 run scoreboard players get #every_choice daisukes.config
execute store result storage daisukes:menu args.max int 1 run scoreboard players get #max_count daisukes.config
execute store result storage daisukes:menu args.change int 1 run scoreboard players get #change_choice daisukes.config
function daisukes:menu/settings/initial with storage daisukes:menu args
execute if score #end_fast daisukes.config matches 1 run data modify storage daisukes:menu dialog.inputs[{key: "endfast"}].initial set value true
execute if score #death_ends daisukes.config matches 1 run data modify storage daisukes:menu dialog.inputs[{key: "death"}].initial set value true

function daisukes:menu/show with storage daisukes:menu
