# Com a una pell: sis trossos del mateix material surten disparats (s'animen el tick seguent) i la pell desapareix
data modify storage daisukes:orbital item set from entity @s item
summon minecraft:item_display ~ ~ ~ {Tags: ["daisukes.orb", "daisukes.orb_shard", "daisukes.orb_shard_new", "daisukes.orb_fresh"], Rotation: [0f, -25f], item_display: "none", brightness: {sky: 15, block: 15}, transformation: {left_rotation: [0f, 0f, 0f, 1f], right_rotation: [0f, 0f, 0f, 1f], translation: [0f, 0f, 0f], scale: [0.2f, 0.2f, 0.2f]}}
summon minecraft:item_display ~ ~ ~ {Tags: ["daisukes.orb", "daisukes.orb_shard", "daisukes.orb_shard_new", "daisukes.orb_fresh"], Rotation: [60f, 10f], item_display: "none", brightness: {sky: 15, block: 15}, transformation: {left_rotation: [0f, 0f, 0f, 1f], right_rotation: [0f, 0f, 0f, 1f], translation: [0f, 0f, 0f], scale: [0.2f, 0.2f, 0.2f]}}
summon minecraft:item_display ~ ~ ~ {Tags: ["daisukes.orb", "daisukes.orb_shard", "daisukes.orb_shard_new", "daisukes.orb_fresh"], Rotation: [120f, -40f], item_display: "none", brightness: {sky: 15, block: 15}, transformation: {left_rotation: [0f, 0f, 0f, 1f], right_rotation: [0f, 0f, 0f, 1f], translation: [0f, 0f, 0f], scale: [0.2f, 0.2f, 0.2f]}}
summon minecraft:item_display ~ ~ ~ {Tags: ["daisukes.orb", "daisukes.orb_shard", "daisukes.orb_shard_new", "daisukes.orb_fresh"], Rotation: [180f, 20f], item_display: "none", brightness: {sky: 15, block: 15}, transformation: {left_rotation: [0f, 0f, 0f, 1f], right_rotation: [0f, 0f, 0f, 1f], translation: [0f, 0f, 0f], scale: [0.2f, 0.2f, 0.2f]}}
summon minecraft:item_display ~ ~ ~ {Tags: ["daisukes.orb", "daisukes.orb_shard", "daisukes.orb_shard_new", "daisukes.orb_fresh"], Rotation: [240f, -15f], item_display: "none", brightness: {sky: 15, block: 15}, transformation: {left_rotation: [0f, 0f, 0f, 1f], right_rotation: [0f, 0f, 0f, 1f], translation: [0f, 0f, 0f], scale: [0.2f, 0.2f, 0.2f]}}
summon minecraft:item_display ~ ~ ~ {Tags: ["daisukes.orb", "daisukes.orb_shard", "daisukes.orb_shard_new", "daisukes.orb_fresh"], Rotation: [300f, 30f], item_display: "none", brightness: {sky: 15, block: 15}, transformation: {left_rotation: [0f, 0f, 0f, 1f], right_rotation: [0f, 0f, 0f, 1f], translation: [0f, 0f, 0f], scale: [0.2f, 0.2f, 0.2f]}}
execute as @e[type=minecraft:item_display,tag=daisukes.orb_fresh] run data modify entity @s item set from storage daisukes:orbital item
tag @e[type=minecraft:item_display,tag=daisukes.orb_fresh] remove daisukes.orb_fresh
kill @s
