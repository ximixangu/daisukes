data modify storage daisukes:registry modifiers append value "king"
data modify storage daisukes:texts map.king set value {"text": "The King", "color": "gold", "bold": true}
data modify storage daisukes:texts desc.king set value "A monster near you is crowned King: while he lives, every monster within 24 blocks of him is invincible. Kill him to steal the crown and leave his court defenseless for 15 s, until the crown picks a new King."
