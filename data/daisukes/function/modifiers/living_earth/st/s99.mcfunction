$data modify storage daisukes:earth s set value {Name: "$(name)", Properties: {power: "0", sculk_sensor_phase: "inactive", waterlogged: "false"}}
$execute if block ~ ~ ~ $(name)[power=1] run data modify storage daisukes:earth s.Properties.power set value "1"
