# Com al marcador dels peus (on era el jugador en el moment del clic): els 4 llocs, un per cada signe de x i de z.
# Nomes si de debo hi ha el centre d'un bloc a aquesta distancia (el mateix calcul que l'avenc)
$execute positioned ~$(px) $(y) ~$(pz) align xz positioned ~0.5 ~ ~0.5 if predicate {condition: "minecraft:entity_properties", entity: "this", predicate: {distance: {x: {min: $(x0)}, z: {min: $(z0)}}}} unless predicate {condition: "minecraft:entity_properties", entity: "this", predicate: {distance: {x: {min: $(x1)}}}} unless predicate {condition: "minecraft:entity_properties", entity: "this", predicate: {distance: {z: {min: $(z1)}}}} run function daisukes:modifiers/living_earth/cand
