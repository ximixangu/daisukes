data modify storage daisukes:registry modifiers append value "junk"
data modify storage daisukes:texts map.junk set value {"text": "Junk Magnet", "color": "#A0B040", "bold": true}
data modify storage daisukes:texts desc.junk set value "Junk keeps stuffing your empty slots and popping up wherever you walk: seeds, string, spider eyes... and white glass panes you can't even see. Whatever you throw away is gone for good, and the rest vanishes when the modifier ends."
