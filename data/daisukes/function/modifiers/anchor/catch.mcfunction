# Com a l'encadenat. Abast 0 (ni blocs ni entitats) i Resistencia V sense particules (sweep la renova cada segon)
attribute @s minecraft:block_interaction_range modifier add daisukes:anchor -1 add_multiplied_total
attribute @s minecraft:entity_interaction_range modifier add daisukes:anchor -1 add_multiplied_total
effect give @s minecraft:resistance 2 4 true
