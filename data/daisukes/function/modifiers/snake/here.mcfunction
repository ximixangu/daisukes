# Com a jugador: la casella d'ara (#x #y #z, a la dimensio #dim) passa a ser la seva ultima casella
scoreboard players operation @s daisukes.sn_x = #x daisukes.sn
scoreboard players operation @s daisukes.sn_y = #y daisukes.sn
scoreboard players operation @s daisukes.sn_z = #z daisukes.sn
scoreboard players operation @s daisukes.sn_dim = #dim daisukes.sn
tag @s add daisukes.sn_on
